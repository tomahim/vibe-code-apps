# Railway terminates TLS before forwarding requests to this HTTP listener.
map $http_x_forwarded_proto $originating_scheme {
    default $http_x_forwarded_proto;
    "" $scheme;
}

# Host keeps the port (e.g. :8080 over Tailscale). Django's CSRF check compares
# the browser's Origin (which includes the port) with the Host header, so using
# $host (port stripped) made admin login fail with 403 on plain-http private URLs.
server {
    # The Tailscale userspace router stalls normal IPv6 request-body writes
    # while IPv4 uploads complete. Refuse IPv6 at connect time so dual-stack
    # browsers fall back to Railway's A record before submitting a form.
    # Keep this IPv4-only until the IPv6 upload probe in the runbook passes.
    listen 0.0.0.0:${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Railway private addresses change when services restart or wake. Resolve
    # the API for each new connection instead of pinning its address at startup.
    resolver [fd12::10] ipv6=off valid=5s;
    resolver_timeout 2s;
    set $api_upstream ${API_UPSTREAM};

    location /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $originating_scheme;
        proxy_read_timeout 60s;
    }

    # Admin image uploads are multipart bodies up to MEDIA_UPLOAD_MAX_BYTES (5 MB)
    # plus form fields. nginx's default client_max_body_size is 1 MB, and uploads
    # over the Tailscale router can be slow, so allow more time between body reads.
    location /admin/ {
        client_max_body_size 6m;
        # Recipe batches allow a 500 MiB ZIP plus multipart form overhead.
        # All other admin uploads retain the individual-image request limit.
        location = /admin/recipes/recipe/import/ {
            client_max_body_size 501m;
            proxy_pass $api_upstream;
            proxy_send_timeout 600s;
            proxy_read_timeout 600s;
        }
        client_body_timeout 120s;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $originating_scheme;
    }

    # Django admin and Unfold both serve assets from the API's static root.
    location /static/ {
        proxy_pass $api_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $originating_scheme;
    }

    location = /health/ {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
